# Local reads are the safest default. Zotero desktop must be running.
ZOTERO_LOCAL=true
ZOTERO_DATA_DIR=~/Zotero

# Required for cloud mode and for writes in hybrid mode.
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=

# Optional standalone DeepSeek chat agent.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
