# Local reads are the safest default. Zotero desktop must be running.
ZOTERO_LOCAL=true
ZOTERO_DATA_DIR=~/Zotero

# Optional: interpreter that already has requirements.txt installed.
# Useful when the agent's default `python` differs from Conda/venv Python.
ZOTERO_PYTHON=

# Required for cloud mode and for writes in hybrid mode.
ZOTERO_LIBRARY_ID=
ZOTERO_LIBRARY_TYPE=user
ZOTERO_API_KEY=
